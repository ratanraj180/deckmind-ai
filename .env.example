# ───────────────────────────────────────────
# MONGODB DATABASE (MongoDB Atlas)
# ───────────────────────────────────────────
# Replace with your MongoDB Atlas connection string:
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# ───────────────────────────────────────────
# AUTHENTICATION (Next-Auth v5)
# ───────────────────────────────────────────
NEXTAUTH_SECRET=replace_with_random_32_char_string_here
NEXTAUTH_URL=http://localhost:3000

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ───────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY (₹10 Presentation Download)
# ───────────────────────────────────────────
# Get these from Razorpay Dashboard (https://dashboard.razorpay.com/app/keys)
# Bank Account Settlement is configured in Razorpay Dashboard -> Settings -> Bank Account (KYC)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourSecretKeyHere
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# ───────────────────────────────────────────
# AI PROVIDERS (modular — use any or both)
# ───────────────────────────────────────────
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ───────────────────────────────────────────
# ADMIN ACCOUNT (never hardcode in source!)
# ───────────────────────────────────────────
ADMIN_EMAIL=ratanas1408@gmail.com
ADMIN_PASSWORD=Ratanas1408@gmail.com

